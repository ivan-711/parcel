# Copy to api/.env for local development. With ENVIRONMENT=development every
# other value is optional: features without a key turn themselves off or fall
# back to recorded data. Anything else counts as production, which refuses to
# start without SECRET_KEY, DATABASE_URL, CLERK_ISSUER and CLERK_WEBHOOK_SECRET.
ENVIRONMENT=development

# A host's plain postgres:// URL works as is.
DATABASE_URL=postgresql+asyncpg://parcel:parcel@localhost:5433/parcel
WEB_ORIGINS=["http://localhost:5173"]
# Signs demo session tokens. Generate one with: openssl rand -base64 48
SECRET_KEY=

# Clerk frontend API URL, e.g. https://clerk.parceldesk.io
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=

# "fixtures" answers lookups from recorded data and spends nothing.
PROVIDERS=fixtures
RENTCAST_API_KEY=
RENTCAST_MONTHLY_BUDGET=45
LOOKUPS_PER_USER_PER_DAY=5
GEOAPIFY_API_KEY=
FRED_API_KEY=
HUD_API_TOKEN=

ANTHROPIC_API_KEY=
MEMOS_PER_DAY_FREE=3
MEMOS_PER_DAY_PRO=30
MEMO_DAILY_BUDGET=150

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

SENTRY_DSN=
LOG_JSON=false
